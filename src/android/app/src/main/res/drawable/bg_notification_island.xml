<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-island-visual: dark semi-transparent rounded card the custom FGS
  notification content sits on, mirroring the in-app capsule's surface
  (ToolOverlayController's #E61C1C1E plate). ~30dp corners, the "island" look.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/notification_island_card" />
    <corners android:radius="@dimen/notification_island_corner" />
</shape>
