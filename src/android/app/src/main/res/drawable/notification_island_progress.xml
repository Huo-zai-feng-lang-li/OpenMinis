<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-island-visual: thin rounded progress bar, brand blue (#78C8FF,
  the overlay ring's accent) over a subtle track. Used both as
  progressDrawable and as indeterminateDrawable: the @android:id/progress
  layer is a <clip>, which is what the framework sweeps for the
  indeterminate marquee.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/notification_island_progress_track" />
            <corners android:radius="@dimen/notification_island_progress_corner" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/notification_island_progress" />
                <corners android:radius="@dimen/notification_island_progress_corner" />
            </shape>
        </clip>
    </item>
</layer-list>
