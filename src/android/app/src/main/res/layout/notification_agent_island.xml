<?xml version="1.0" encoding="utf-8"?>
<!--
  T-android-island-visual: custom content view for the agent FGS
  notification (RemoteViews). Dark rounded "island" card: left icon tile,
  bold white title + grey-white subtitle, thin brand-blue rounded progress
  bar, small rounded-capsule Stop control.

  RemoteViews whitelist only — stock view classes (LinearLayout, TextView,
  ImageView, ProgressBar), so it inflates in the system process on any ROM.
  The system always keeps the default layout too (title/text/progress/actions
  are still set on the Builder); ROMs that ignore custom views (e.g. MIUI's
  超灵动岛 chrome, which draws the notification's own shell) fall back to
  the default row and are at least tinted with the notification color.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_island_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notification_island"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/notification_island_icon"
            android:layout_width="@dimen/notification_island_icon_size"
            android:layout_height="@dimen/notification_island_icon_size"
            android:background="@drawable/bg_notification_island_icon"
            android:padding="9dp"
            android:scaleType="center"
            android:tint="@color/notification_island_title"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_island_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/notification_island_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_island_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/notification_island_subtitle"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notification_island_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/notification_island_progress_height"
        android:layout_marginTop="10dp"
        android:max="100"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/notification_island_progress"
        android:progressDrawable="@drawable/notification_island_progress"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notification_island_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minWidth="56dp"
        android:gravity="center"
        android:background="@drawable/bg_notification_island_stop"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/bg_service_stop_action"
        android:textColor="@color/notification_island_stop_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
